{
  "name": "dsh-host",
  "version": "0.6.8",
  "description": "DSH Host plugin for DeepSeek Harness — run Codex, Claude Code, and Antigravity natively inside DSH with a plugin-owned local backend.",
  "private": false,
  "type": "module",
  "icon": "./icon.svg",
  "main": "./index.mjs",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-host",
    "codex",
    "claude-code",
    "antigravity",
    "codexhost",
    "multi-agent"
  ],
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "os": [
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:client": "node build-client.mjs",
    "build:backend": "node scripts/setup-backend.mjs",
    "build": "npm run build:client && npm run build:backend",
    "market:index": "node scripts/update-market-index.mjs",
    "release": "node scripts/release.mjs",
    "test": "node --test test/*.test.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs"
  },
  "optionalDependencies": {
    "@codexhost/cli-win32-x64": "0.17.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.0.5-alpha.1 || ~4.0.6-alpha.1 || ~4.1.0",
    "@deepseek-ai/dsh": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.5-alpha.1 || ~3.18.6-alpha.1 || ~3.19.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "zod": "^3.24.0"
  },
  "exports": {
    ".": "./index.mjs",
    "./protocol": "./protocol.mjs",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "platforms": [
        "win32"
      ],
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-permission-presets",
        "@deepseek-ai/dsh-client-ui-agent-preset",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remote-access"
      ],
      "immediately": true
    }
  },
  "files": [
    "index.mjs",
    "backend-builder.mjs",
    "backend-paths.mjs",
    "backend/**",
    "build-backend.mjs",
    "build-client.mjs",
    "scripts/**",
    "antigravity-perf.mjs",
    "antigravity-visibility.mjs",
    "patch-antigravity-perf.mjs",
    "antigravity-collaboration.mjs",
    "patch-antigravity-collaboration.mjs",
    "patch-codex-lazy-start.mjs",
    "file-uri-links.mjs",
    "host-identity.mjs",
    "subagent-settlement.mjs",
    "last-agent.mjs",
    "claude-catalog-cache.mjs",
    "claude-503-relay.mjs",
    "claude-efforts.mjs",
    "claude-native-web.txt",
    "claude-*.txt",
    "patch-claude-*.mjs",
    "patch-host-*.mjs",
    "*-rpc-backend.txt",
    "autonomous-team-collaboration.mjs",
    "host-collaboration.mjs",
    "host-installation.mjs",
    "host-usage-totals.mjs",
    "live-token-usage.mjs",
    "local-model-prices.mjs",
    "build-local-prices.mjs",
    "native-*.mjs",
    "owned-host-runtime.mjs",
    "console-*.mjs",
    "delegation-*.mjs",
    "external-engines.mjs",
    "harness-route.mjs",
    "codex-permissions.mjs",
    "permission-presentation.mjs",
    "thinking-options.mjs",
    "preset-view.mjs",
    "plugin-updater.mjs",
    "protocol.mjs",
    "rejected-start.mjs",
    "remote-contract.mjs",
    "runtime-client.mjs",
    "session-api-cost.mjs",
    "slider-runtime.mjs",
    "slider-licenses/**",
    "workspace-file-paths.mjs",
    "client.mjs",
    "client.js",
    "icons.mjs",
    "assets/*",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/**",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "market-index.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayujie/dsh-host.git"
  },
  "homepage": "https://github.com/jayujie/dsh-host#readme",
  "bugs": {
    "url": "https://github.com/jayujie/dsh-host/issues"
  },
  "license": "MIT"
}
